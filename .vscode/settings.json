{
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-tinytex",
      "command": "/Users/dylan/Library/TinyTeX/bin/universal-darwin/latexmk",
      "args": [
        "-pdf",
        "-pdflatex=/Users/dylan/Library/TinyTeX/bin/universal-darwin/pdflatex %O %S",
        "-interaction=nonstopmode",
        "-synctex=1",
        "-file-line-error",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (TinyTeX)",
      "tools": ["latexmk-tinytex"]
    }
  ],
  "latex-workshop.latex.recipe.default": "latexmk (TinyTeX)",
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.view.pdf.viewer": "tab"
}
